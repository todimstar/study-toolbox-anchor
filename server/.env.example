HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./toolbox.db

# Micro chat
# Parent key should not be embedded in the child-facing page. Enter it on the parent device.
PARENT_CHAT_KEY=change-parent-chat-key
# Child key is returned by POST /api/micro-chat/pair and stored on the device.
# Do NOT embed it in toolbox-site/index.html.
CHILD_CHAT_KEY=change-child-chat-key
# First-launch install code for the child APK. Empty = pairing disabled.
CHILD_PAIR_CODE=
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=20971520
